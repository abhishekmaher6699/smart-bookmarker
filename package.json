{
  "name": "smart-bookmarker-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import=tsx/esm --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "node --env-file=.env --import=tsx/esm src/workers/enrichment.worker.ts",
    "migrate": "node --env-file=.env --import=tsx/esm src/db/migrate.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@mozilla/readability": "^0.6.0",
    "@prometheus-io/client": "^0.16.1",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ipaddr.js": "^2.5.0",
    "jsdom": "^29.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "redis": "^6.2.1",
    "redis-cli": "^2.1.2",
    "resend": "^6.28.1",
    "supertest": "^7.2.2",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
